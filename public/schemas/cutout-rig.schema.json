{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KILSAT cutout rig",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,100}$"
          },
          "parent": {
            "type": "string"
          },
          "pivot": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "pivotFrame": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "z": {
            "type": "number"
          },
          "switch": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "pivot",
          "bounds",
          "z"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "required": [
    "version",
    "width",
    "height",
    "layers"
  ],
  "additionalProperties": false
}
